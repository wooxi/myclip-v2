// myclip-v2 Worker 配置
// 部署: CLOUDFLARE_API_TOKEN=... CLOUDFLARE_ACCOUNT_ID=... npx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myclip-v2",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "myclip.chongya.ccwu.cc",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "myclip-v2-db",
      "database_id": "d0987fbd-00aa-49d0-850a-2a771d71277e"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "myclip-v2-files"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM_DO",
        "class_name": "RoomDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomDO"]
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
