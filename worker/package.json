{
  "name": "myclip-v2-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute myclip-v2-db --remote --file schema.sql",
    "db:init:local": "wrangler d1 execute myclip-v2-db --local --file schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261115.1",
    "typescript": "^5.9.0",
    "wrangler": "^4.162.0"
  }
}
